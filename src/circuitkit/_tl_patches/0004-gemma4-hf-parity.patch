+            "output_logits_soft_cap": 30.0,   # text_config.final_logit_softcapping
             "window_size": 1024,
             "use_local_attn": True,
             "attn_types": [
@@ -2391,11 +2388,6 @@ def get_pretrained_state_dict(
         elif cfg.original_architecture == "MixtralForCausalLM":
             state_dict = convert_mixtral_weights(hf_model, cfg)
         elif cfg.original_architecture == "SarvamMoEForCausalLM":
-            # Raises by default: the weight mapping is implemented, but TL's MoE
