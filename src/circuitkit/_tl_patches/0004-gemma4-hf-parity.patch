         cfg_dict = {
             "d_model": 5376,
             "d_head": 512,
@@ -1586,7 +1580,8 @@ def convert_hf_model_config(model_name: str, **kwargs: Any) -> dict[str, Any]:
             "normalization_type": "RMS",
             "rotary_base": 1000000,          # full_attention ("global") layers
             "rotary_base_local": 10000,       # sliding_attention ("local") layers
-            "rotary_dim": 128,                # global: partial_rotary_factor 0.25 * d_head(512)
+            "rotary_dim": 512,                # global: proportional RoPE spans the full head
+            "proportional_rotary_factor": 0.25,
             "rotary_dim_local": 256,          # local: full rotary over d_head_local(256)
             "positional_embedding_type": "rotary",
             "use_attn_scale": True,
@@ -1596,6 +1591,8 @@ def convert_hf_model_config(model_name: str, **kwargs: Any) -> dict[str, Any]:
             "use_normalization_before_and_after": True,
