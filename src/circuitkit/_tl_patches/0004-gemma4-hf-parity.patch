From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pratinav Seth <pratinav.seth@lexsi.ai>
Date: Sat, 26 Sep 2026 22:46:06 +0530
Subject: [PATCH 4/5] gemma4: match HF (proportional RoPE, final softcap,
 layer_scalar)

Not in the vendored fork. Measured on a tiny random Gemma4ForConditionalGeneration
(fp32): without this patch max |dlogit| 0.108 and top-1 agreement 0.875 vs HF; with it
7e-5 and 1.0. Global layers used a partial rotary_dim=128 where HF's proportional RoPE
rotates 64 pairs spread over the full 512-dim head; final_logit_softcapping=30 was not
applied; the per-layer layer_scalar buffer was ignored. Also drops two stale sarvam
comments that referred to a removed SARVAM_MOE_UNSUPPORTED.

diff --git a/transformer_lens/components/abstract_attention.py b/transformer_lens/components/abstract_attention.py
index d54b4f2..6e6b613 100644
--- a/transformer_lens/components/abstract_attention.py
+++ b/transformer_lens/components/abstract_attention.py
@@ -774,6 +774,12 @@ class AbstractAttention(ABC, nn.Module):
             scaling_factor = getattr(self.cfg, "rotary_scaling_factor", 1.0)
             if scaling_factor != 1.0 and self.attn_type != "local":
                 freq = freq * scaling_factor
+            # Gemma 4 "proportional" RoPE: pairs past int(factor * rotary_dim // 2) get
+            # inv_freq 0 (an infinite period), matching transformers'
+            # _compute_proportional_rope_parameters.
+            proportional = self.cfg.proportional_rotary_factor
+            if proportional is not None and self.attn_type != "local":
+                freq[int(proportional * rotary_dim // 2) :] = float("inf")
         if self.cfg.rotary_adjacent_pairs:
             freq = einops.repeat(freq, "d -> (d 2)")
         else:
diff --git a/transformer_lens/components/transformer_block.py b/transformer_lens/components/transformer_block.py
index e303ba4..4aafaa0 100644
--- a/transformer_lens/components/transformer_block.py
+++ b/transformer_lens/components/transformer_block.py
@@ -155,6 +155,8 @@ class TransformerBlock(nn.Module):
         if not self.cfg.attn_only and not self.cfg.parallel_attn_mlp:
             self.hook_resid_mid = HookPoint()  # [batch, pos, d_model]
         self.hook_resid_post = HookPoint()  # [batch, pos, d_model]
+        if self.cfg.use_layer_scalar:
+            self.register_buffer("layer_scalar", torch.ones(1, dtype=self.cfg.dtype))
 
     def forward(
         self,
@@ -262,7 +264,10 @@ class TransformerBlock(nn.Module):
             else:
                 normalized_resid_mid = self.ln2(mlp_in)
                 mlp_out = self.apply_mlp(normalized_resid_mid)
-            resid_post = self.hook_resid_post(resid_mid + mlp_out)  # [batch, pos, d_model]
+            resid_post = resid_mid + mlp_out
+            if self.cfg.use_layer_scalar:
+                resid_post = resid_post * self.layer_scalar
+            resid_post = self.hook_resid_post(resid_post)  # [batch, pos, d_model]
         elif self.cfg.parallel_attn_mlp:
             # Dumb thing done by GPT-J, both MLP and Attn read from resid_pre and write to resid_post, no resid_mid used.
             # In GPT-J, LN1 and LN2 are tied, in GPT-NeoX they aren't.
diff --git a/transformer_lens/config/hooked_transformer_config.py b/transformer_lens/config/hooked_transformer_config.py
index e0bcc93..81e6e4c 100644
--- a/transformer_lens/config/hooked_transformer_config.py
+++ b/transformer_lens/config/hooked_transformer_config.py
@@ -257,6 +257,15 @@ class HookedTransformerConfig(TransformerLensConfig):
             before attention (Gemma 4: every layer's value path is RMS-normalized with no
             learned scale, mirroring q_norm/k_norm's mechanism but without a weight -- see
             `use_qk_norm`). Defaults to False.
+        proportional_rotary_factor (float, *optional*): HF ``rope_type="proportional"`` (Gemma 4
+            global layers). Frequencies are laid out over the full ``rotary_dim``, but only the
+            first ``int(factor * rotary_dim // 2)`` pairs rotate; the rest pass through
+            unrotated. Not the same as a partial ``rotary_dim``, which changes both the
+            frequencies and which dimensions pair up. Applied to non-local layers only.
+            Defaults to None.
+        use_layer_scalar (bool): Multiply each block's output (residual included) by a
+            per-block scalar buffer ``layer_scalar`` (Gemma 4's ``Gemma4TextDecoderLayer``).
+            Defaults to False.
         norm_topk_prob (bool): Whether to normalize the top-k probabilities in the MoE layer.
         use_logn_attn (bool): Qwen-1's log-n attention: scale queries by
             log_{train_len}(position) past the training length (eval only).
@@ -323,6 +332,8 @@ class HookedTransformerConfig(TransformerLensConfig):
     n_key_value_heads_local: Optional[int] = None
     rotary_dim_local: Optional[int] = None
     use_v_norm: bool = False
+    proportional_rotary_factor: Optional[float] = None
+    use_layer_scalar: bool = False
     rotary_scaling_factor: float = (
         1.0  # Linear RoPE scaling factor for global attention (e.g., 8.0 for Gemma 3 4B)
     )
