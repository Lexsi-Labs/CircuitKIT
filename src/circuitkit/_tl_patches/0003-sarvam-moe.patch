-
-        # choose the top k(=experts_per_token) experts to use
-        # both are [batch, pos, experts_per_token]
-        weights = self.hook_expert_weights(F.softmax(gate_logits, dim=1, dtype=torch.float))
-        weights, expert_indices = torch.topk(weights, self.experts_per_token, dim=-1)
-        if self.cfg.norm_topk_prob:
-            weights /= weights.sum(dim=-1, keepdim=True)
-        expert_indices = self.hook_expert_indices(expert_indices)
-        weights = weights.to(x.dtype)
+        sigmoid_router = self.cfg.moe_router_score_function == "sigmoid"
+        if sigmoid_router:
+            # Router in fp32 end-to-end, exactly as SarvamMoEGate.forward:
+            # `F.linear(hidden.float(), weight.float())` -> sigmoid(float) ->
+            # + expert_bias -> top-k. Doing the matmul in bf16 flips top-6
+            # selections on near-tied scores, which is a DIFFERENT set of
+            # experts firing, not rounding noise.
+            gate_logits = F.linear(x.float(), self.W_gate.weight.float())
+            scores = self.hook_expert_weights(torch.sigmoid(gate_logits))
+        else:
+            gate_logits = self.W_gate(x)
+            scores = self.hook_expert_weights(F.softmax(gate_logits, dim=1, dtype=torch.float))
+
+        scores_for_routing = scores + self.expert_bias.float() if self.cfg.use_expert_bias else scores
+        expert_indices = self._group_limited_topk(scores_for_routing)
+        # Weight uses the UNBIASED score at the selected indices (DeepSeek-V3
+        # aux-loss-free balancing: the bias steers WHICH experts fire, not how
+        # much each one contributes once selected). For the plain-softmax path
+        # (every other MoE model), scores_for_routing IS scores, so this is
+        # unchanged from the original top-k-of-softmax behavior.
+        weights = torch.gather(scores, dim=-1, index=expert_indices)
+
+        if sigmoid_router:
+            # sarvam-30b always renormalizes when top_k > 1 (unconditional,
+            # not gated by norm_topk_prob -- that flag stays reserved for the
+            # softmax-router models that already used it).
+            if self.experts_per_token > 1:
+                weights = weights / (weights.sum(dim=-1, keepdim=True) + 1e-20)
+            if self.cfg.routed_scaling_factor is not None:
+                weights = weights * self.cfg.routed_scaling_factor
+        elif self.cfg.norm_topk_prob:
+            weights = weights / weights.sum(dim=-1, keepdim=True)
 
-        results = torch.zeros((batch * pos, d_model), dtype=x.dtype, device=x.device)
+        expert_indices = self.hook_expert_indices(expert_indices)
+        if sigmoid_router:
+            # HF: expert outputs (bf16) are cast to the fp32 weight dtype, scaled,
+            # summed over the k experts in fp32, then cast back once.
+            acc_dtype = torch.float32
+        else:
+            weights = weights.to(x.dtype)
+            acc_dtype = x.dtype
+
+        results = torch.zeros((batch * pos, d_model), dtype=acc_dtype, device=x.device)
+        # Only materialize the [tokens, k, d_model] per-expert buffer when something
+        # is actually listening -- otherwise this is pure overhead on every forward.
+        want_contribs = bool(self.hook_expert_contributions.fwd_hooks)
+        contribs = (
+            torch.zeros((batch * pos, self.experts_per_token, d_model), dtype=acc_dtype, device=x.device)
+            if want_contribs
+            else None
+        )
         expert_mask = F.one_hot(expert_indices, num_classes=self.num_experts).permute(2, 1, 0)
         for expert_idx in range(self.num_experts):
             expert_layer = self.experts[expert_idx]
@@ -110,11 +215,34 @@ class MoE(CanBeUsedAsMLP):
             # states by `routing_weights` on the corresponding tokens (top-1 and top-2)
             current_state = x[None, top_x].reshape(-1, d_model)
 
-            current_hidden_states = expert_layer(current_state) * weights[top_x, idx, None]
+            current_hidden_states = expert_layer(current_state).to(acc_dtype) * weights[top_x, idx, None].to(acc_dtype)
 
             # However `index_add_` only support torch tensors for indexing so we'll use
             # the `top_x` tensor here.
-            results.index_add_(0, top_x, current_hidden_states.to(x.dtype))
+            results.index_add_(0, top_x, current_hidden_states.to(acc_dtype))
+
+            if want_contribs:
+                # `idx` is the top-k SLOT index and `top_x` the token index (see the
+                # one_hot/permute above), so this lands c_{l,e} in the slot that
+                # hook_expert_indices reports for that token -- keeping the two hooks
+                # index-aligned.
+                contribs[top_x, idx] = current_hidden_states.to(acc_dtype)
+
+        if want_contribs:
+            self.hook_expert_contributions(
+                contribs.view(batch, pos, self.experts_per_token, d_model)
+            )
+
+        results = results.to(x.dtype)
+        self.hook_routed_out(results.view(batch, pos, d_model))
+        if self.cfg.num_shared_experts:
+            # Applied to every token unconditionally, added on top of the
+            # routed-expert sum -- matches `y + self.shared_experts(identity)`
+            # in SarvamMoESparseMoeBlock.forward. NOT scaled by
+            # routed_scaling_factor (that only multiplies routed weights).
+            shared = self.shared_experts(x).to(x.dtype)
+            self.hook_shared_out(shared.view(batch, pos, d_model))
+            results = results + shared
 
         results = results.reshape(batch, pos, d_model)
         return results
