@@ -77,29 +78,133 @@ class MoE(CanBeUsedAsMLP):
         self.experts = nn.ModuleList([MoEGatedMLP(self.cfg) for _ in range(self.num_experts)])
         self.W_gate = nn.Linear(self.cfg.d_model, self.cfg.num_experts, bias=False, dtype=self.cfg.dtype)
 
+        # sarvam_moe: learned per-expert bias added to routing scores before
+        # top-k (changes selection, not the final weight -- see forward()).
+        # Parameter, not buffer, so it survives state_dict load the same way
+        # every other converted weight does.
+        if self.cfg.use_expert_bias:
+            self.expert_bias = nn.Parameter(torch.zeros(self.num_experts, dtype=self.cfg.dtype))
+
+        # sarvam_moe: always-on expert(s), added to every token's output on
+        # top of the routed experts. One wider MLP (d_mlp * num_shared_experts),
+        # not num_shared_experts separate ones -- matches SarvamMoESparseMoeBlock.
+        if self.cfg.num_shared_experts:
+            shared_cfg = dataclasses.replace(
+                self.cfg, d_mlp=self.cfg.d_mlp * self.cfg.num_shared_experts
