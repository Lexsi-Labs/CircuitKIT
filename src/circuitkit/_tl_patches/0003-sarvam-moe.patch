+
         # Hook on the weights of selected experts [batch pos experts_per_token]
         self.hook_expert_weights = HookPoint()
         # Hook on the indices of selected experts [batch pos experts_per_token]
         self.hook_expert_indices = HookPoint()
 
+        # --- MoE-C-DeltaTheta Phase A component hooks -------------------------
+        # These are the routed and shared-expert components used for
+        # activation-level analysis:
+        #   c_{l,e}(x) = g_{l,e}(x) * E_{l,e}(h_l)   -- the ROUTED contribution,
+        #     i.e. the expert output already scaled by its routing weight, NOT
+        #     the router probability and NOT the unscaled expert output.
+        #   E^shared_l(h_l)                          -- always-on shared expert.
+        # (The attention side already has blocks.{l}.hook_attn_out.)
+        #
+        # hook_expert_contributions is [tokens, experts_per_token, d_model]:
+        # slot j of token t holds c_{l,e} for e = hook_expert_indices[t, j], so
+        # the two hooks are index-aligned. Sparse by construction (k=6 of 128).
+        # Building it costs tokens*k*d_model, so it is only materialized when
+        # something is actually hooked -- see the `.fwd_hooks` guard in forward().
+        self.hook_expert_contributions = HookPoint()
+        # Summed routed contribution, BEFORE the shared expert is added.
+        self.hook_routed_out = HookPoint()  # [batch, pos, d_model]
+        # Shared-expert output alone.
+        self.hook_shared_out = HookPoint()  # [batch, pos, d_model]
+
+    def _group_limited_topk(
+        self, scores_for_routing: Float[torch.Tensor, "tokens num_experts"]
+    ) -> torch.Tensor:
+        """DeepSeek-V3-style device-limited routing: only experts in the
+        top `topk_group` groups (by their best-2-experts score sum) may be
+        selected. Verified against sarvam-30b's own SarvamMoEGate.group_limited_topk.
+        With n_group in (None, 1) this is mathematically identical to plain
+        top-k (every expert is in the one always-selected group) -- which is
+        sarvam-30b's actual config (n_group=1), so this path is exercised for
+        correctness/generality but is a no-op on that model specifically.
+        """
+        n_group = self.cfg.n_group
+        if not n_group or n_group <= 1:
+            return torch.topk(scores_for_routing, self.experts_per_token, dim=-1).indices
+        num_tokens = scores_for_routing.shape[0]
+        group_scores = (
+            scores_for_routing.view(num_tokens, n_group, -1).topk(2, dim=-1)[0].sum(dim=-1)
+        )
+        group_idx = torch.topk(group_scores, k=self.cfg.topk_group, dim=-1, sorted=False)[1]
+        group_mask = torch.zeros_like(group_scores)
+        group_mask.scatter_(1, group_idx, 1)
+        score_mask = (
+            group_mask.unsqueeze(-1)
+            .expand(num_tokens, n_group, self.num_experts // n_group)
+            .reshape(num_tokens, -1)
+        )
+        masked_scores = scores_for_routing.masked_fill(~score_mask.bool(), float("-inf"))
+        return torch.topk(masked_scores, k=self.experts_per_token, dim=-1).indices
+
     def forward(
         self, x: Float[torch.Tensor, "batch pos d_model"]
     ) -> Float[torch.Tensor, "batch pos d_model"]:
         # [batch, pos, d_model] -> [batch, pos, num_experts]
         batch, pos, d_model = x.shape
         x = x.view(-1, d_model)
