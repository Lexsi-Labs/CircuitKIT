index 0000000..571e99f
--- /dev/null
+++ b/transformer_lens/pretrained/weight_conversions/sarvam_moe.py
@@ -0,0 +1,169 @@
+"""Weight conversion for sarvamai/sarvam-30b (SarvamMoEForCausalLM).
+
+TransformerLens has no support for this architecture; its own model registry lists
+``SarvamMoEForCausalLM`` in ``tools/model_registry/data/architecture_gaps.json``
+(12 models, ~279k downloads, relevancy 41.2) as a known gap.
+
+Ground truth for everything below is the checkpoint's own ``config.json`` and the
+``trust_remote_code`` modules it ships (``configuration_sarvam_moe.py``,
+``modeling_sarvam_moe.py``) -- ``sarvam_moe`` is NOT in ``transformers``, so there is
+no upstream implementation to read instead.
+
+Architecture (sarvam-30b)::
+
+    19 layers, d_model 4096, 64 heads / 4 KV heads, head_dim 64, rope_theta 8e6
+    128 experts, 6 per token, moe_intermediate 1024, 1 shared expert
+    first_k_dense_replace=1  -> layer 0 is a DENSE MLP (intermediate 8192),
+                                layers 1..18 are sparse MoE
+
+Two things differ from every MoE TransformerLens already converts:
+
+1. **Fused QKV.** ``attention.query_key_value`` is a single Linear of shape
+   ``[(n_heads + 2*n_kv_heads) * head_dim, d_model]`` = ``[4608, 4096]``, and the
+   output projection is named ``dense`` (not ``o_proj``). Mixtral/OLMoE all have
+   separate q/k/v. The split order (Q, then K, then V) is taken from
+   ``SarvamMoEAttention.forward``, not assumed.
+2. **QK-norm is per-head.** ``query_layernorm``/``key_layernorm`` are RMSNorms over
+   ``head_dim`` (64), which maps onto TL's ``use_qk_norm`` path
+   (``RMSNorm(cfg, length=cfg.d_head)``) exactly.
+
+Sarvam's RMSNorm is ``weight * x`` (Llama-style), NOT Gemma's ``(1 + weight) * x`` --
+so norm weights are copied straight through with no folding.
+
+Router/MLP semantics (shared expert, sigmoid routing, expert_bias, routed_scaling_factor,
+per-layer dense/sparse split) are now implemented in ``components/mlps/moe.py`` and
+``components/transformer_block.py`` -- verified line-by-line against sarvam-30b's own
+``modeling_sarvam_moe.py`` (``SarvamMoEGate.forward``, ``SarvamMoESparseMoeBlock``), not
+guessed or assumed to match DeepSeek-V3. See those files' docstrings/comments for the
+exact math and what was checked. This converter maps every tensor to its TL home,
+including the ones previously listed as unrepresentable.
+"""
+
+import einops
+import torch
+
+from transformer_lens.config.hooked_transformer_config import HookedTransformerConfig
+
+def convert_sarvam_moe_weights(model, cfg: HookedTransformerConfig):
+    """Convert a HF ``SarvamMoEForCausalLM`` into a TransformerLens state dict.
+
+    Args:
+        model: the loaded HF model (``trust_remote_code=True`` required).
+        cfg: the target TransformerLens config (must have moe_router_score_function,
+            use_expert_bias, num_shared_experts, first_k_dense_replace, d_mlp_dense
+            set -- see loading_from_pretrained.py's sarvam-30b cfg_dict).
+
+    Returns:
+        dict: TransformerLens-format state dict.
+    """
+    assert cfg.n_key_value_heads is not None
+    assert cfg.num_experts is not None
+    assert cfg.d_mlp is not None
+
+    hf = model.model
+    state_dict = {"embed.W_E": hf.word_embeddings.weight}
+
+    n_q = cfg.n_heads * cfg.d_head
+    n_kv = cfg.n_key_value_heads * cfg.d_head
+
+    for l in range(cfg.n_layers):
+        layer = hf.layers[l]
+        state_dict[f"blocks.{l}.ln1.w"] = layer.input_layernorm.weight
+        state_dict[f"blocks.{l}.ln2.w"] = layer.post_attention_layernorm.weight
+
+        # --- attention: split the fused query_key_value ---------------------------
+        # [ (n_heads + 2*n_kv_heads) * d_head, d_model ], ordered Q | K | V per
+        # SarvamMoEAttention.forward.
+        qkv = layer.attention.query_key_value.weight
+        expected = n_q + 2 * n_kv
+        if qkv.shape[0] != expected:
+            raise ValueError(
+                f"layer {l}: fused query_key_value has {qkv.shape[0]} rows, expected "
+                f"{expected} = n_heads*d_head ({n_q}) + 2*n_kv_heads*d_head ({2 * n_kv}). "
+                "The Q|K|V split order or head layout differs from what this converter assumes."
+            )
+        W_Q, W_K, W_V = qkv[:n_q], qkv[n_q : n_q + n_kv], qkv[n_q + n_kv :]
+        state_dict[f"blocks.{l}.attn.W_Q"] = einops.rearrange(
+            W_Q, "(n h) m -> n m h", n=cfg.n_heads)
+        state_dict[f"blocks.{l}.attn._W_K"] = einops.rearrange(
+            W_K, "(n h) m -> n m h", n=cfg.n_key_value_heads)
+        state_dict[f"blocks.{l}.attn._W_V"] = einops.rearrange(
+            W_V, "(n h) m -> n m h", n=cfg.n_key_value_heads)
+
+        state_dict[f"blocks.{l}.attn.b_Q"] = torch.zeros(cfg.n_heads, cfg.d_head, dtype=cfg.dtype)
+        state_dict[f"blocks.{l}.attn._b_K"] = torch.zeros(
+            cfg.n_key_value_heads, cfg.d_head, dtype=cfg.dtype)
+        state_dict[f"blocks.{l}.attn._b_V"] = torch.zeros(
+            cfg.n_key_value_heads, cfg.d_head, dtype=cfg.dtype)
+
+        # output projection is `dense`, not `o_proj`
+        state_dict[f"blocks.{l}.attn.W_O"] = einops.rearrange(
+            layer.attention.dense.weight, "m (n h) -> n h m", n=cfg.n_heads)
+        state_dict[f"blocks.{l}.attn.b_O"] = torch.zeros(cfg.d_model, dtype=cfg.dtype)
+
+        # per-head QK RMSNorm (config.use_qk_norm) -> TL's RMSNorm(cfg, length=d_head)
+        if getattr(cfg, "use_qk_norm", False):
+            state_dict[f"blocks.{l}.attn.q_norm.w"] = layer.attention.query_layernorm.weight
+            state_dict[f"blocks.{l}.attn.k_norm.w"] = layer.attention.key_layernorm.weight
+
+        # --- MLP -----------------------------------------------------------------
+        mlp = layer.mlp
+        is_dense_layer = l < (cfg.first_k_dense_replace or 0)
+
+        if is_dense_layer:
+            # TransformerBlock.__init__ builds this layer with a per-layer cfg
+            # override (num_experts=None, gated_mlp=True, d_mlp=d_mlp_dense) --
+            # see components/transformer_block.py -- so it's a GatedMLP here,
+            # not a MoE. GatedMLP's W_gate/W_in/W_out are bare nn.Parameters
+            # shaped [d_model, d_mlp] (W_out: [d_mlp, d_model]), i.e.
+            # TRANSPOSED vs. nn.Linear.weight's [out_features, in_features] --
+            # unlike the routed-expert copies below, these need `.T`.
+            if hasattr(mlp, "experts"):
+                raise ValueError(
+                    f"layer {l} < first_k_dense_replace={cfg.first_k_dense_replace} "
+                    f"but HF layer {l} has `.experts` (is MoE, not dense) -- "
+                    f"first_k_dense_replace disagrees with the checkpoint."
+                )
+            state_dict[f"blocks.{l}.mlp.W_gate"] = mlp.gate_proj.weight.T
+            state_dict[f"blocks.{l}.mlp.W_in"] = mlp.up_proj.weight.T
+            state_dict[f"blocks.{l}.mlp.W_out"] = mlp.down_proj.weight.T
+            # Sarvam's dense MLP has bias=False throughout; GatedMLP always
+            # carries b_in/b_out (zero-initialized), so make that explicit
+            # rather than relying on strict=False to paper over it.
+            state_dict[f"blocks.{l}.mlp.b_in"] = torch.zeros(cfg.d_mlp_dense, dtype=cfg.dtype)
+            state_dict[f"blocks.{l}.mlp.b_out"] = torch.zeros(cfg.d_model, dtype=cfg.dtype)
+        else:
+            if not hasattr(mlp, "experts"):
+                raise ValueError(
+                    f"layer {l} >= first_k_dense_replace={cfg.first_k_dense_replace} "
+                    f"but HF layer {l} has no `.experts` (is dense, not MoE) -- "
+                    f"first_k_dense_replace disagrees with the checkpoint."
+                )
+            state_dict[f"blocks.{l}.mlp.W_gate.weight"] = mlp.gate.weight
+            for e in range(cfg.num_experts):
+                expert = mlp.experts[e]
+                state_dict[f"blocks.{l}.mlp.experts.{e}.W_gate.weight"] = expert.gate_proj.weight
+                state_dict[f"blocks.{l}.mlp.experts.{e}.W_in.weight"] = expert.up_proj.weight
+                state_dict[f"blocks.{l}.mlp.experts.{e}.W_out.weight"] = expert.down_proj.weight
+
+            # Learned per-expert bias added to routing scores before top-k
+            # (config.moe_router_enable_expert_bias) -- MoE.__init__ only
+            # creates this parameter when cfg.use_expert_bias is set.
+            if hasattr(mlp.gate, "expert_bias") and mlp.gate.expert_bias is not None:
+                state_dict[f"blocks.{l}.mlp.expert_bias"] = mlp.gate.expert_bias
+
+            # Always-on shared expert (config.num_shared_experts=1). Its MLP is
+            # a plain MoEGatedMLP-shaped module (nn.Linear-backed, same
+            # convention as the routed experts above -- no transpose), just
+            # wider (moe_intermediate_size * num_shared_experts). MoE.__init__
+            # only creates `self.shared_experts` when cfg.num_shared_experts is set.
+            if hasattr(mlp, "shared_experts"):
+                se = mlp.shared_experts
+                state_dict[f"blocks.{l}.mlp.shared_experts.W_gate.weight"] = se.gate_proj.weight
+                state_dict[f"blocks.{l}.mlp.shared_experts.W_in.weight"] = se.up_proj.weight
+                state_dict[f"blocks.{l}.mlp.shared_experts.W_out.weight"] = se.down_proj.weight
+
+    state_dict["ln_final.w"] = hf.norm.weight
+    state_dict["unembed.W_U"] = model.lm_head.weight.T
+    state_dict["unembed.b_U"] = torch.zeros(cfg.d_vocab, dtype=cfg.dtype)
+    return state_dict
