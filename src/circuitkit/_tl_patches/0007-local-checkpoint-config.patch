+++ b/transformer_lens/loading_from_pretrained.py
@@ -151,6 +151,11 @@ def get_official_model_name(model_name: str) -> str:
     return official_model_name
 
 
+# Patch 0007: local checkpoints take their config and model class from
+# config.json, never from their path name. Read by circuitkit.load_model.
+LOCAL_CHECKPOINTS_FROM_CONFIG = True
+
