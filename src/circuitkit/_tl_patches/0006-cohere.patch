Subject: [PATCH 6/6] cohere: add weight conversion for Cohere architectures

Cohere config conversion and architecture registration are owned by
`circuitkit.backends._tl_compat.cohere`. This patch supplies the corresponding
weight-conversion hook to TransformerLens 3.8 for registered Cohere models.
---
 transformer_lens/loading_from_pretrained.py   |  3 +++
 .../pretrained/weight_conversions/__init__.py |  1 +
 .../pretrained/weight_conversions/cohere.py   | 59 +++++++++++++++++++
 transformer_lens/supported_models.py          | 12 ++++
 4 files changed, 75 insertions(+)
 create mode 100644 transformer_lens/pretrained/weight_conversions/cohere.py

diff --git a/transformer_lens/loading_from_pretrained.py b/transformer_lens/loading_from_pretrained.py
index 30f216d..853a28b 100644
--- a/transformer_lens/loading_from_pretrained.py
+++ b/transformer_lens/loading_from_pretrained.py
@@ -33,6 +33,7 @@ from transformer_lens.pretrained.weight_conversions import (
     convert_bert_weights,
     convert_bloom_weights,
     convert_coder_weights,
+    convert_cohere_weights,
     convert_gemma4_weights,
     convert_gemma_weights,
     convert_gpt2_weights,
@@ -2399,6 +2400,8 @@ def get_pretrained_state_dict(
             state_dict = convert_qwen_weights(hf_model, cfg)
         elif cfg.original_architecture == "Qwen2ForCausalLM":
             state_dict = convert_qwen2_weights(hf_model, cfg)
+        elif cfg.original_architecture in ("CohereForCausalLM", "Cohere2ForCausalLM"):
