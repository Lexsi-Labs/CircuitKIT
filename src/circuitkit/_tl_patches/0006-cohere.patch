index 0000000..b6f3a2d
--- /dev/null
+++ b/transformer_lens/pretrained/weight_conversions/cohere.py
@@ -0,0 +1,59 @@
+import einops
+import torch
+
+from transformer_lens.config.hooked_transformer_config import HookedTransformerConfig
+
+
+def convert_cohere_weights(cohere, cfg: HookedTransformerConfig):
+    """CohereForCausalLM / Cohere2ForCausalLM.
+
+    Each layer has a single bias-free input_layernorm read by both attention and
+    MLP (parallel block); it is copied to ln1 and ln2. logit_scale is folded into W_U.
+    """
+    state_dict = {}
+    zeros = lambda *shape: torch.zeros(*shape, dtype=cfg.dtype)
+
+    state_dict["embed.W_E"] = cohere.model.embed_tokens.weight
+
+    assert cfg.d_mlp is not None  # keep mypy happy
+    n_kv_heads = cfg.n_key_value_heads or cfg.n_heads
+
+    for l in range(cfg.n_layers):
+        layer = cohere.model.layers[l]
+        attn = layer.self_attn
+
+        state_dict[f"blocks.{l}.ln1.w"] = layer.input_layernorm.weight
+        state_dict[f"blocks.{l}.ln1.b"] = zeros(cfg.d_model)
+        state_dict[f"blocks.{l}.ln2.w"] = layer.input_layernorm.weight
+        state_dict[f"blocks.{l}.ln2.b"] = zeros(cfg.d_model)
+
+        state_dict[f"blocks.{l}.attn.W_Q"] = einops.rearrange(
+            attn.q_proj.weight, "(n h) m->n m h", n=cfg.n_heads
+        )
+        state_dict[f"blocks.{l}.attn._W_K"] = einops.rearrange(
+            attn.k_proj.weight, "(n h) m->n m h", n=n_kv_heads
+        )
+        state_dict[f"blocks.{l}.attn._W_V"] = einops.rearrange(
+            attn.v_proj.weight, "(n h) m->n m h", n=n_kv_heads
+        )
+        state_dict[f"blocks.{l}.attn.b_Q"] = zeros(cfg.n_heads, cfg.d_head)
+        state_dict[f"blocks.{l}.attn._b_K"] = zeros(n_kv_heads, cfg.d_head)
+        state_dict[f"blocks.{l}.attn._b_V"] = zeros(n_kv_heads, cfg.d_head)
+        state_dict[f"blocks.{l}.attn.W_O"] = einops.rearrange(
+            attn.o_proj.weight, "m (n h)->n h m", n=cfg.n_heads
+        )
+        state_dict[f"blocks.{l}.attn.b_O"] = zeros(cfg.d_model)
+
+        state_dict[f"blocks.{l}.mlp.W_in"] = layer.mlp.up_proj.weight.T
+        state_dict[f"blocks.{l}.mlp.W_gate"] = layer.mlp.gate_proj.weight.T
+        state_dict[f"blocks.{l}.mlp.b_in"] = zeros(cfg.d_mlp)
+        state_dict[f"blocks.{l}.mlp.W_out"] = layer.mlp.down_proj.weight.T
+        state_dict[f"blocks.{l}.mlp.b_out"] = zeros(cfg.d_model)
+
+    state_dict["ln_final.w"] = cohere.model.norm.weight
+    state_dict["ln_final.b"] = zeros(cfg.d_model)
+
+    state_dict["unembed.W_U"] = (cohere.lm_head.weight * cohere.config.logit_scale).T
+    state_dict["unembed.b_U"] = zeros(cfg.d_vocab)
+
+    return state_dict
