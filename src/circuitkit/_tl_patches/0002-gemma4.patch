From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pratinav Seth <pratinav.seth@lexsi.ai>
Date: Sat, 26 Sep 2026 22:31:20 +0530
Subject: [PATCH 2/5] gemma4: google/gemma-4-31B-it support

Per-layer-type attention geometry (d_head_local, n_key_value_heads_local,
rotary_dim_local) via a per-layer cfg copy in TransformerBlock; unscaled
v_norm (use_v_norm); convert_gemma4_weights (no +1 RMSNorm fold,
attention_k_eq_v -> W_V := W_K on global layers); registry + cfg_dict.

diff --git a/transformer_lens/components/abstract_attention.py b/transformer_lens/components/abstract_attention.py
index 936978f..d54b4f2 100644
--- a/transformer_lens/components/abstract_attention.py
+++ b/transformer_lens/components/abstract_attention.py
@@ -33,6 +33,7 @@ class AbstractAttention(ABC, nn.Module):
     alibi: Union[torch.Tensor, None]
     q_norm: Optional[RMSNorm]
     k_norm: Optional[RMSNorm]
+    v_norm: Optional[RMSNorm]
     mask: torch.Tensor
     IGNORE: torch.Tensor
     rotary_sin: torch.Tensor
@@ -117,6 +118,18 @@ class AbstractAttention(ABC, nn.Module):
             self.q_norm = None
             self.k_norm = None
 
+        if self.cfg.use_v_norm:
+            # Gemma 4: every layer's value path is RMS-normalized with NO learned
+            # scale (HF's Gemma4RMSNorm(with_scale=False) has no weight parameter
+            # at all). TransformerLens's RMSNorm always allocates a weight, so we
+            # represent "no scale" by allocating one and pinning it to all-ones,
+            # which is mathematically identical to an unscaled RMSNorm --
+            # convert_gemma4_weights() never writes a checkpoint value into it, so
+            # it stays at its torch.ones() init.
+            self.v_norm: Optional[RMSNorm] = RMSNorm(self.cfg, length=self.cfg.d_head)
+        else:
+            self.v_norm = None
+
         self.attn_type = attn_type
         if self.attn_type == "local":
             if not isinstance(self.cfg.window_size, int):
