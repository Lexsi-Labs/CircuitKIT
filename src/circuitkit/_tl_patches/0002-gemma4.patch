diff --git a/transformer_lens/components/transformer_block.py b/transformer_lens/components/transformer_block.py
index e1ebda8..b38ece5 100644
--- a/transformer_lens/components/transformer_block.py
+++ b/transformer_lens/components/transformer_block.py
@@ -3,6 +3,7 @@
 This module contains all the component :class:`TransformerBlock`.
 """
 
+import dataclasses
 from typing import Callable, Dict, Optional, Union
 
 import torch
@@ -82,7 +83,42 @@ class TransformerBlock(nn.Module):
             if self.cfg.attn_types is None:
                 raise ValueError("attn_types must be set when using local attention")
             attn_type = self.cfg.attn_types[block_index]
-            self.attn = attention(self.cfg, attn_type, block_index)
+
+            # Per-layer-type attention-geometry override (Gemma 4): "local"
+            # (sliding-window) layers there use a different head_dim,
+            # n_key_value_heads, and rotary_dim than "global" layers -- not
+            # just a different RoPE base like Gemma 3's rotary_base_local.
+            # Build a per-layer *effective* cfg (a cheap dataclass copy) only
+            # for local layers when any *_local override is actually set;
+            # every other model leaves these at None and gets the exact same
+            # `self.cfg` object for every layer, unchanged from upstream.
+            attn_cfg = self.cfg
+            if attn_type == "local" and (
+                self.cfg.d_head_local is not None
+                or self.cfg.n_key_value_heads_local is not None
+                or self.cfg.rotary_dim_local is not None
+            ):
+                overrides: Dict[str, object] = {}
+                if self.cfg.d_head_local is not None:
+                    overrides["d_head"] = self.cfg.d_head_local
+                if self.cfg.n_key_value_heads_local is not None:
+                    overrides["n_key_value_heads"] = self.cfg.n_key_value_heads_local
+                if self.cfg.rotary_dim_local is not None:
+                    overrides["rotary_dim"] = self.cfg.rotary_dim_local
+                # dataclasses.replace() re-runs __post_init__, so attn_scale
+                # (when left at the auto-compute sentinel -1.0) and n_params
+                # recompute consistently for this layer's overridden d_head.
+                attn_cfg = dataclasses.replace(self.cfg, **overrides)
+
+            attention_for_layer = (
+                Attention if attn_cfg.n_key_value_heads is None else GroupedQueryAttention
+            )
+            self.attn = attention_for_layer(attn_cfg, attn_type, block_index)
+        # Per-layer-effective cfg (equals self.cfg unless overridden above) --
+        # forward() below must size the split-qkv-input head-repeat by this,
+        # not self.cfg, or a "local" layer's smaller n_key_value_heads_local
+        # mismatches the K/V input it actually receives.
+        self.attn_cfg = attn_cfg if self.cfg.use_local_attn else self.cfg
         if not self.cfg.attn_only:
             self.mlp = MLPFactory.create_mlp(self.cfg)
 
@@ -135,9 +171,12 @@ class TransformerBlock(nn.Module):
             )
 
         if self.cfg.use_split_qkv_input:
+            # Sized by self.attn_cfg (this layer's effective cfg), not
+            # self.cfg: on a "local" layer with n_key_value_heads_local set,
+            # self.attn actually expects the smaller local head count.
             n_kv_heads = (
-                self.cfg.n_key_value_heads
-                if self.cfg.n_key_value_heads is not None
+                self.attn_cfg.n_key_value_heads
+                if self.attn_cfg.n_key_value_heads is not None
                 and not self.cfg.ungroup_grouped_query_attention
                 else self.cfg.n_heads
             )
