index ecfa25b..1f24a18 100644
--- a/transformer_lens/pretrained/weight_conversions/gemma.py
+++ b/transformer_lens/pretrained/weight_conversions/gemma.py
@@ -137,3 +137,134 @@ def convert_gemma_weights(gemma, cfg: HookedTransformerConfig):
     state_dict["unembed.b_U"] = torch.zeros(cfg.d_vocab, dtype=cfg.dtype, device=unembed_device)
 
     return state_dict
+
+
+def convert_gemma4_weights(gemma4, cfg: HookedTransformerConfig):
+    """Weight conversion for Gemma 4 (verified against modeling_gemma4.py directly,
+    not extrapolated from Gemma 3 -- see loading_from_pretrained.py's gemma-4-31b
+    cfg_dict block and docs/CTHETA_GEMMA4_AUDIT.md in the audit repo this was
+    written for, for the full trace of what was checked and what remains an
+    open/approximated detail).
+
+    Key differences from convert_gemma_weights (Gemma 1-3) that make this its
+    own function rather than a shared path:
+      - Gemma4RMSNorm does NOT add 1 to the weight before scaling (plain
+        `x * weight`, weight init'd to ones) -- Gemma 1-3's GemmaRMSNorm does
+        (`x * (1 + weight)`), which is why that converter pre-adds 1 everywhere.
+        Doing that here would be wrong, not just redundant.
+      - head_dim and n_key_value_heads vary by layer type (attn_types[l]),
+        not just the RoPE base -- this function looks each layer's effective
+        values up per-layer rather than reading a single cfg.d_head/
+        cfg.n_key_value_heads for every layer.
+      - attention_k_eq_v=True on every full_attention ("global") layer means
+        those layers have no v_proj at all in HF; value states reuse the raw
+        key projection. Represented here by copying W_K into TL's independent
+        W_V slot for those layers (see the cfg_dict block's docstring for why
+        this is fine for C-Delta-Theta's actual use of this model).
+    """
+    state_dict = {}
+
+    assert cfg.attn_types is not None  # keep mypy happy; required for use_local_attn
+    assert cfg.d_mlp is not None
+    assert cfg.n_key_value_heads is not None
+
+    language_model = getattr(gemma4, "language_model", None)
+    if language_model is None:
+        language_model = getattr(getattr(gemma4, "model", None), "language_model", None)
+    if language_model is not None:
+        base_model = getattr(language_model, "model", language_model)
+    else:
+        base_model = gemma4.model
+
+    # Gemma4TextScaledWordEmbedding.weight is stored RAW; the sqrt(d_model)
+    # scale is applied in its forward(), not folded into the weight, so we
+    # fold it in here to match every other Gemma converter's convention.
+    state_dict["embed.W_E"] = base_model.embed_tokens.weight * torch.tensor(
+        cfg.d_model**0.5, dtype=cfg.dtype
+    )
+
+    for l in range(cfg.n_layers):
+        is_local = cfg.attn_types[l] == "local"
+        d_head = cfg.d_head_local if (is_local and cfg.d_head_local is not None) else cfg.d_head
+        n_kv = (
+            cfg.n_key_value_heads_local
+            if (is_local and cfg.n_key_value_heads_local is not None)
+            else cfg.n_key_value_heads
+        )
+        assert n_kv is not None
+
+        layer = base_model.layers[l]
+        attn = layer.self_attn
+
+        # Gemma4RMSNorm: plain `x * weight`, no +1 folding (verified, see
+        # docstring above) -- copy straight across.
+        state_dict[f"blocks.{l}.ln1.w"] = layer.input_layernorm.weight.float()
+        if cfg.use_normalization_before_and_after:
+            state_dict[f"blocks.{l}.ln1_post.w"] = layer.post_attention_layernorm.weight.float()
+
+        W_Q = attn.q_proj.weight
+        W_Q = einops.rearrange(W_Q, "(n h) m -> n m h", n=cfg.n_heads)
+        state_dict[f"blocks.{l}.attn.W_Q"] = W_Q
+        state_dict[f"blocks.{l}.attn.b_Q"] = torch.zeros(
+            cfg.n_heads, d_head, dtype=cfg.dtype, device=W_Q.device
+        )
+
+        W_K = attn.k_proj.weight
+        W_K = einops.rearrange(W_K, "(n h) m -> n m h", n=n_kv)
+        state_dict[f"blocks.{l}.attn._W_K"] = W_K
+        state_dict[f"blocks.{l}.attn._b_K"] = torch.zeros(
+            n_kv, d_head, dtype=cfg.dtype, device=W_K.device
+        )
+
+        # attention_k_eq_v: on layers where HF has no v_proj at all (verified:
+        # every full_attention/"global" layer in google/gemma-4-31B-it), reuse
+        # the raw k_proj weights for TL's independent W_V slot.
+        v_proj = getattr(attn, "v_proj", None)
+        W_V = v_proj.weight if v_proj is not None else attn.k_proj.weight
+        W_V = einops.rearrange(W_V, "(n h) m -> n m h", n=n_kv)
+        state_dict[f"blocks.{l}.attn._W_V"] = W_V
+        state_dict[f"blocks.{l}.attn._b_V"] = torch.zeros(
+            n_kv, d_head, dtype=cfg.dtype, device=W_V.device
+        )
+
+        # q_norm/k_norm: ordinary scaled Gemma4RMSNorm, plain copy (no +1).
+        state_dict[f"blocks.{l}.attn.q_norm.w"] = attn.q_norm.weight.float()
+        state_dict[f"blocks.{l}.attn.k_norm.w"] = attn.k_norm.weight.float()
+        # v_norm: HF's is unscaled (Gemma4RMSNorm(with_scale=False) has no
+        # weight parameter to copy at all) -- deliberately not written here,
+        # so TL's v_norm.w keeps its all-ones init, which is mathematically
+        # identical to "no scale".
+
+        W_O = attn.o_proj.weight
+        W_O = einops.rearrange(W_O, "m (n h) -> n h m", n=cfg.n_heads)
+        state_dict[f"blocks.{l}.attn.W_O"] = W_O
+        state_dict[f"blocks.{l}.attn.b_O"] = torch.zeros(
+            cfg.d_model, dtype=cfg.dtype, device=W_O.device
+        )
+
+        # Sandwich norm (pre/post feedforward) -- present unconditionally in
+        # Gemma4TextDecoderLayer, independent of the (here-disabled) MoE path.
+        state_dict[f"blocks.{l}.ln2.w"] = layer.pre_feedforward_layernorm.weight.float()
+        state_dict[f"blocks.{l}.ln2_post.w"] = layer.post_feedforward_layernorm.weight.float()
+
+        state_dict[f"blocks.{l}.mlp.W_in"] = layer.mlp.up_proj.weight.T
+        state_dict[f"blocks.{l}.mlp.W_gate"] = layer.mlp.gate_proj.weight.T
+        state_dict[f"blocks.{l}.mlp.b_in"] = torch.zeros(
+            cfg.d_mlp, dtype=cfg.dtype, device=layer.mlp.up_proj.weight.device
+        )
+        state_dict[f"blocks.{l}.mlp.W_out"] = layer.mlp.down_proj.weight.T
+        state_dict[f"blocks.{l}.mlp.b_out"] = torch.zeros(
+            cfg.d_model, dtype=cfg.dtype, device=layer.mlp.down_proj.weight.device
+        )
+
+    state_dict["ln_final.w"] = base_model.norm.weight.float()
+
+    if hasattr(gemma4, "lm_head"):
+        state_dict["unembed.W_U"] = gemma4.lm_head.weight.T
+        unembed_device = gemma4.lm_head.weight.device
+    else:
+        state_dict["unembed.W_U"] = base_model.embed_tokens.weight.T
+        unembed_device = base_model.embed_tokens.weight.device
+    state_dict["unembed.b_U"] = torch.zeros(cfg.d_vocab, dtype=cfg.dtype, device=unembed_device)
+
+    return state_dict
